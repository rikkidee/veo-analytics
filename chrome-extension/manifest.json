{
  "manifest_version": 3,
  "name": "Veo Analytics Importer",
  "version": "1.0.0",
  "description": "Import your Veo match report stats into your Veo Analytics account. Independent tool, not affiliated with Veo.",
  "homepage_url": "https://veo-analytics.vercel.app",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["scripting"],
  "host_permissions": [
    "https://app.veo.co/*",
    "http://localhost:3000/*",
    "https://veo-analytics.vercel.app/*"
  ],
  "action": {
    "default_title": "Veo Analytics Importer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.veo.co/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:3000/*", "https://veo-analytics.vercel.app/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
