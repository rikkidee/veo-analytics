{
  "manifest_version": 3,
  "name": "Veo Analytics Scraper",
  "version": "0.1.0",
  "description": "Scrapes team and player stats from a Veo match report for Veo Analytics.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Veo Analytics Scraper",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.veo.co/matches/*/report*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
